# En local, `npx prisma dev` affiche ces deux adresses.
DATABASE_URL=
SHADOW_DATABASE_URL=

# `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=

# Adresses autorisées à retirer un jeu de l'annuaire, séparées par des virgules.
ADMIN_EMAILS=

# Production uniquement. Sans EMAIL_SERVER en local, le lien de connexion s'affiche dans le terminal.
# Format : smtp://utilisateur:motdepasse@smtp.exemple.fr:587
EMAIL_SERVER=
EMAIL_FROM="Rituel <rituel@projectp.fr>"
