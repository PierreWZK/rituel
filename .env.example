# En local, `npx prisma dev` affiche ces deux adresses.
DATABASE_URL=
SHADOW_DATABASE_URL=

# `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=
# Production : l'adresse publique du site, utilisée dans les liens des e-mails.
# AUTH_URL=https://rituel.projectp.fr

# Administrateurs (valident les jeux proposés, reçoivent un e-mail à chaque proposition), séparés par des virgules.
ADMIN_EMAILS=

# Production uniquement. Sans EMAIL_SERVER en local, les e-mails s'affichent dans le terminal.
# Format : smtp://utilisateur:motdepasse@smtp.exemple.fr:587 (ou smtps://…:465)
EMAIL_SERVER=
EMAIL_FROM="Rituel <rituel@projectp.fr>"
